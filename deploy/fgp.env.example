NODE_ENV=production
PORT=3001
HOST=127.0.0.1
PUBLIC_APP_ORIGIN=https://forhud.shop
INITIAL_SETUP_TOKEN=REPLACE_WITH_A_ONE_TIME_SETUP_SECRET
DATABASE_URL=file:/var/lib/fgp/lead-intelligence.db
BACKUP_DIR=/var/backups/fgp
SCRAPER_URL=http://127.0.0.1:3011
SCRAPER_PORT=3011
SCRAPER_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
PLAYWRIGHT_BROWSERS_PATH=/var/lib/fgp/browsers
SCRAPER_BROWSER_EXECUTABLE=/usr/bin/google-chrome-stable
BRAVE_SEARCH_API_KEY=REPLACE_WITH_A_NEW_BRAVE_API_KEY
MAX_SEARCH_TARGET_RESULTS=5000
BRAVE_MAX_REQUESTS=300
BRAVE_SEARCH_CONCURRENCY=3
BRAVE_SEARCH_CACHE_TTL_MS=900000
BRAVE_SEARCH_CACHE_MAX_PAGES=2000
DISCORD_INVITE_RECONCILE_CONCURRENCY=2
DISCORD_INVITE_TIMEOUT_MS=8000
DISCORD_INVITE_RECONCILE_DEADLINE_MS=600000
SCRAPER_MAX_BODY_BYTES=10485760
SCRAPER_GLOBAL_CONCURRENCY=32
SCRAPER_DYNAMIC_CONCURRENCY=3
SCRAPER_MAX_SCROLL_STEPS=6
SCRAPER_SCROLL_WAIT_MS=125
LZT_TRACKER_ENABLED=false
LZT_API_BASE_URL=https://prod-api.lzt.market
LZT_API_TOKEN=
LZT_POLL_INTERVAL_MS=3100
LZT_RECONCILIATION_INTERVAL_MS=900000
LZT_RUST_APP_ID=252490
LZT_MAX_PRICE_USD=20
LZT_NOTIFY_BELOW_USD=5.00
LZT_NOTIFY_HIGH_HOURS_BELOW_USD=6.00
LZT_NOTIFY_HIGH_HOURS_MINIMUM=2000
LZT_DISPLAY_CURRENCY=eur
LZT_TIMEZONE=Europe/Copenhagen
HAZE_LZT_NOTIFICATIONS_ENABLED=false
DISCORD_USER_TOKEN=
HAZE_LZT_CHANNEL_ID=
HAZE_LZT_POLL_MS=1000
