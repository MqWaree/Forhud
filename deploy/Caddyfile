forhud.shop, www.forhud.shop {
    encode zstd gzip

    handle /api/* {
        reverse_proxy 127.0.0.1:3001
    }

    handle {
        root * /opt/fgp/apps/dashboard/dist

        # Vite emits content-hashed files under /assets; they never change at a given URL.
        @immutable path /assets/*
        header @immutable Cache-Control "public, max-age=31536000, immutable"

        # The brand logo is small and rarely changes; allow a day of caching.
        @logo path /fgp-logo.png
        header @logo Cache-Control "public, max-age=86400"

        # Everything else (index.html and SPA routes) must revalidate so a new
        # release is picked up immediately via ETag.
        header ?Cache-Control "no-cache"

        try_files {path} /index.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
